{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Only local data during development. Sites provisions its own database.
  "d1_databases": [
    { "binding": "DB", "database_name": "web-app", "database_id": "00000000-0000-0000-0000-000000000000" }
  ]
}
